from sentence_transformers import SentenceTransformer

# Load a multilingual embedding model
embedding_model = SentenceTransformer(
    "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
)

print("Embedding model loaded successfully!")


documents = []

for restaurant_id, restaurant in restaurant_data.items():

    # Restaurant general information
    general_info = f"""
    Restaurant: {restaurant['name']}
    Opening hours: {restaurant['opening_hours']}
    Delivery zones and prices: {restaurant['delivery_zones']}
    Promotion: {restaurant['promotion']}
    """

    documents.append({
        "text": general_info,
        "restaurant_id": restaurant_id,
        "type": "general"
    })

    # Pizza information
    for pizza in restaurant["items"]:

        pizza_info = f"""
        Restaurant: {restaurant['name']}
        Pizza: {pizza['name']}
        Prices by size: {pizza['sizes']}
        Ingredients: {pizza['ingredients']}
        Allergens: {pizza['allergens']}
        """

        documents.append({
            "text": pizza_info,
            "restaurant_id": restaurant_id,
            "type": "menu"
        })

print("Documents created:", len(documents))
print("\nExample document:")
print(documents[0]["text"])


texts = [doc["text"] for doc in documents]

document_embeddings = embedding_model.encode(
    texts,
    convert_to_numpy=True,
    normalize_embeddings=True
)

print("Embeddings created successfully!")
print("Number of vectors:", len(document_embeddings))
print("Vector dimensions:", document_embeddings.shape[1])


import os
from getpass import getpass
from google import genai

# Uses the GOOGLE_API_KEY environment variable, otherwise asks for it.
# Works in VS Code, Jupyter and Colab. Never write the key in the notebook.
api_key = os.environ.get("GOOGLE_API_KEY") or getpass("Google API key: ")
client = genai.Client(api_key=api_key)

MODEL_NAME = "gemini-3.1-flash-lite"
print("Gemini client created successfully!")


import time
from google.genai import errors


def generate_text(prompt, model_name=MODEL_NAME, max_retries=4):
    """Call Gemini, retrying on rate limit (429) and server overload (503)."""
    for attempt in range(max_retries):
        try:
            response = client.models.generate_content(model=model_name, contents=prompt)
            return (response.text or "").strip()
        except errors.APIError as e:
            if e.code in (429, 503) and attempt < max_retries - 1:
                wait = 6 * (attempt + 1)
                print(f"API status {e.code}. Retrying in {wait}s...")
                time.sleep(wait)
            else:
                raise


def normalize_restaurant_id(restaurant_id):
    """Accept 'italian_corner' as well as 'Italian Corner'."""
    key = restaurant_id.strip().lower().replace(" ", "_")
    if key not in restaurant_data:
        raise ValueError(f"Unknown restaurant: {restaurant_id!r}")
    return key


def retrieve_documents(question, restaurant_id, top_k=3):
    """Return the top_k most similar documents of one restaurant."""
    restaurant_id = normalize_restaurant_id(restaurant_id)

    query = embedding_model.encode(
        [question], convert_to_numpy=True, normalize_embeddings=True
    )[0]

    # Vectors are normalized, so the dot product is the cosine similarity.
    scores = document_embeddings @ query

    candidates = [
        i for i, doc in enumerate(documents)
        if doc["restaurant_id"] == restaurant_id
    ]
    best = sorted(candidates, key=lambda i: scores[i], reverse=True)[:top_k]
    results = [{**documents[i], "score": float(scores[i])} for i in best]

    # Always include hours, delivery and promotion information.
    if not any(r["type"] == "general" for r in results):
        i = next(i for i in candidates if documents[i]["type"] == "general")
        results.append({**documents[i], "score": float(scores[i])})

    return results


def normalize_question(question):

    prompt = f"""
Translate the following customer question into English.

Rules:
- Understand Algerian Darija.
- Understand Arabizi.
- Understand French.
- Preserve pizza names and sizes.
- Do not answer the question.
- Only return the translated question.

Customer question:
{question}

English translation:
"""

    return generate_text(prompt)


def build_rag_prompt(question, results):

    context = "\n\n".join(
        result["text"] for result in results
    )

    prompt = f"""
You are a helpful multilingual pizza ordering assistant.

Answer the customer's question using ONLY the information
provided in the context.

IMPORTANT LANGUAGE RULES:
1. If the customer writes in English, answer in English.
2. If the customer writes in French, answer in French.
3. If the customer writes in Algerian Darija using Arabic letters,
   understand the question and answer in Algerian Darija using Arabic letters.
4. If the customer writes in Arabizi (Algerian Darija using Latin
   letters and numbers), understand the question and answer in Arabizi.
5. Do not translate the answer into another language unless requested.

INFORMATION RULES:
1. Never invent prices, ingredients, allergens, or restaurant information.
2. Use ONLY the information provided in the context.
3. If the requested information is missing, clearly say that you do not know.
4. For allergy questions, state ONLY the allergens listed in the context and explicitly note that cross-contamination cannot be ruled out and safety cannot be guaranteed.
5. Be polite, clear, and concise.
6. All prices are in Algerian dinars. Always write DA after a price.

CONTEXT:
{context}

CUSTOMER QUESTION:
{question}

ANSWER:
"""

    return prompt


def ask_restaurant_assistant(question, restaurant_id, top_k=3):
    restaurant_id = normalize_restaurant_id(restaurant_id)
    normalized_question = normalize_question(question)   # English, for retrieval
    results = retrieve_documents(normalized_question, restaurant_id, top_k=top_k)
    prompt = build_rag_prompt(question, results)         # original, for the reply language
    return generate_text(prompt)


