with open("tests/menu_tests.json", "r", encoding="utf-8") as f:
    saved_menu_tests = json.load(f)

predictions = []

for item in saved_menu_tests:
    try:
        predicted = ask_restaurant_assistant(item["question"], item["restaurant"])
    except errors.APIError as e:
        predicted = f"API error ({e.code})"

    predictions.append({**item, "predicted_answer": predicted})
    print(f"[{item['id']}] Q: {item['question']}")
    print(f"      Expected : {item['expected_answer']}")
    print(f"      Predicted: {predicted}")
    print("-" * 60)
    time.sleep(5)

with open("results/menu_predictions.json", "w", encoding="utf-8") as f:
    json.dump(predictions, f, ensure_ascii=False, indent=4)
